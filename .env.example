# Abhishek Faltankar Portfolio - Environment Configuration Example
# Copy this file to .env to configure your local or deployment environment.

# Your direct contact email (displayed on the portfolio and used for mailto links)
# Example: VITE_CONTACT_EMAIL=abhishekfaltankar@example.com
VITE_CONTACT_EMAIL=

# Optional: Formspree or Formkeep endpoint for the contact form
# If provided, messages sent through the contact form are dispatched here.
# If omitted, the website automatically falls back to honest mailto links.
# Example: VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xvgkqabw
VITE_FORMSPREE_ENDPOINT=
